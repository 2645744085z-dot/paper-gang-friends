{
  "name": "paper-gang-zh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "纸牌帮·群友专属版：中文实时联机协作扑克劫案",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/prepare-worker.mjs && wrangler dev --local",
    "dev:cloudflare": "node scripts/prepare-worker.mjs && wrangler dev --local",
    "build": "tsc && tsc -p tsconfig.worker.json --noEmit && node scripts/prepare-worker.mjs",
    "test": "vitest run",
    "deploy:cloudflare": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "4.158.0",
    "@cloudflare/workers-types": "^5.20261104.1"
  }
}
